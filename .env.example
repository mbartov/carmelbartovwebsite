# Neon Postgres connection string.
# On Vercel, install the Neon integration from the Marketplace and it sets this.
# A local Postgres works for development (localhost uses the TCP driver):
#   docker run -d --name carmel-cms-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=carmel -p 5432:5432 postgres:16
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carmel

# Passphrase for /admin. Server-only — never prefix with NEXT_PUBLIC_.
ADMIN_PASSPHRASE=

# Signs the admin session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
